# Ferret Configuration
# Copy this file to .env and fill in your values.

# =============================================================================
# Global Settings
# =============================================================================

## Dry run mode — when True, no changes are written (test mode)
DRYRUN = "True"

## Log level: INFO, DEBUG, or TRACE
DEBUG_LEVEL = "INFO"

## Exit after a single sync cycle
RUN_ONLY_ONCE = "False"

## Seconds between sync cycles
SLEEP_DURATION = "3600"

## Log file path
LOG_FILE = "log.log"

## Mark file — records all items marked as watched
MARK_FILE = "mark.log"

## API request timeout (seconds)
REQUEST_TIMEOUT = 300

## Generate GUIDs — slower but needed if servers have different files
GENERATE_GUIDS = "True"

## Generate Locations — faster, use if servers share the same media files
GENERATE_LOCATIONS = "True"

## Map usernames between servers (JSON): {"PlexUser": "JellyfinUser"}
USER_MAPPING = ""

## Map library names between servers (JSON): {"Movies": "Films"}
LIBRARY_MAPPING = ""

# =============================================================================
# Plex
# =============================================================================

## Server URL (comma-separated for multiple)
PLEX_BASEURL = ""

## Plex token (comma-separated for multiple)
## https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/
PLEX_TOKEN = ""

## Alternative: login via Plex account (comma-separated for multiple)
# PLEX_USERNAME = ""
# PLEX_PASSWORD = ""
# PLEX_SERVERNAME = ""

## Skip SSL hostname validation
SSL_BYPASS = "False"

# =============================================================================
# Jellyfin
# =============================================================================

## Server URL (comma-separated for multiple)
JELLYFIN_BASEURL = ""

## API key (comma-separated for multiple)
JELLYFIN_TOKEN = ""

# =============================================================================
# Emby
# =============================================================================

## Server URL (comma-separated for multiple)
EMBY_BASEURL = ""

## API key (comma-separated for multiple)
EMBY_TOKEN = ""

# =============================================================================
# Sync Directions
# =============================================================================

SYNC_FROM_PLEX_TO_JELLYFIN = "True"
SYNC_FROM_PLEX_TO_PLEX = "True"
SYNC_FROM_PLEX_TO_EMBY = "True"

SYNC_FROM_JELLYFIN_TO_PLEX = "True"
SYNC_FROM_JELLYFIN_TO_JELLYFIN = "True"
SYNC_FROM_JELLYFIN_TO_EMBY = "True"

SYNC_FROM_EMBY_TO_PLEX = "True"
SYNC_FROM_EMBY_TO_JELLYFIN = "True"
SYNC_FROM_EMBY_TO_EMBY = "True"

# =============================================================================
# Blacklist / Whitelist
# =============================================================================

## Comma-separated library names to exclude/include
BLACKLIST_LIBRARY = ""
WHITELIST_LIBRARY = ""

## Comma-separated library types to exclude/include (movie, show)
BLACKLIST_LIBRARY_TYPE = ""
WHITELIST_LIBRARY_TYPE = ""

## Comma-separated usernames to exclude/include
BLACKLIST_USERS = ""
WHITELIST_USERS = ""

# =============================================================================
# Cleanup (Media Lifecycle) — DRY RUN ONLY
# =============================================================================

## Enable/disable the cleanup engine
CLEANUP_ENABLED = "False"

## Dry run mode for cleanup (True = log only, no deletions)
CLEANUP_DRY_RUN = "True"

## Max days since last watch before flagging (shows and movies)
CLEANUP_SHOW_MAX_AGE = 730
CLEANUP_MOVIE_MAX_AGE = 730

## Skip shows that are still airing
CLEANUP_EXCLUDE_CONTINUING = "True"

## Comma-separated titles or patterns to exclude (e.g. "Star*,Battlestar*,The Office")
CLEANUP_EXCLUDE_TITLES = ""

## Days after flagging before an item becomes eligible for deletion
CLEANUP_DELETE_AFTER_DAYS = 30

## Days after a Seerr request before flagging as "Requested & Unwatched"
CLEANUP_REQUEST_UNWATCHED_DAYS = 30

## Path to persistent cleanup state file
CLEANUP_STATE_FILE = "/app/data/cleanup_state.json"

# =============================================================================
# Seerr (Overseerr / Jellyseerr) Integration
# =============================================================================

## Server URL (e.g. http://192.168.1.100:5055)
SEERR_BASEURL = ""

## API key (Settings > General in Seerr UI)
SEERR_API_KEY = ""

# =============================================================================
# Sonarr Integration (for unmonitored shows rule + deletion)
# =============================================================================

SONARR_BASEURL = ""
SONARR_API_KEY = ""

# =============================================================================
# Radarr Integration (for movie deletion)
# =============================================================================

RADARR_BASEURL = ""
RADARR_API_KEY = ""
