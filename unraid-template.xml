<?xml version="1.0"?>
<Container version="2">
  <Name>Ferret</Name>
  <Repository>ghcr.io/mondominator/ferret:latest</Repository>
  <Registry>https://ghcr.io/</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/mondominator/ferret</Support>
  <Project>https://github.com/mondominator/ferret</Project>
  <Overview>Ferret syncs watch status between Plex, Jellyfin, and Emby. When you watch something on one server, Ferret marks it as watched on all others.</Overview>
  <Category>MediaServer:Other</Category>
  <WebUI>http://[IP]:[PORT:8080]/</WebUI>
  <TemplateURL/>
  <Icon>https://raw.githubusercontent.com/mondominator/ferret/main/static/ferret-icon.png</Icon>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <DonateText/>
  <DonateLink/>
  <Requires/>
  <Config Name="Web Port" Target="8080" Default="8080" Mode="tcp" Description="Dashboard port" Type="Port" Display="always" Required="true" Mask="false">8080</Config>
  <Config Name="Plex URL" Target="PLEX_BASEURL" Default="" Mode="" Description="Plex server URL (e.g. http://192.168.1.100:32400)" Type="Variable" Display="always" Required="false" Mask="false"/>
  <Config Name="Plex Token" Target="PLEX_TOKEN" Default="" Mode="" Description="Plex authentication token" Type="Variable" Display="always" Required="false" Mask="true"/>
  <Config Name="Jellyfin URL" Target="JELLYFIN_BASEURL" Default="" Mode="" Description="Jellyfin server URL (e.g. http://192.168.1.100:8096)" Type="Variable" Display="always" Required="false" Mask="false"/>
  <Config Name="Jellyfin Token" Target="JELLYFIN_TOKEN" Default="" Mode="" Description="Jellyfin API key" Type="Variable" Display="always" Required="false" Mask="true"/>
  <Config Name="Emby URL" Target="EMBY_BASEURL" Default="" Mode="" Description="Emby server URL" Type="Variable" Display="always" Required="false" Mask="false"/>
  <Config Name="Emby Token" Target="EMBY_TOKEN" Default="" Mode="" Description="Emby API key" Type="Variable" Display="always" Required="false" Mask="true"/>
  <Config Name="Dry Run" Target="DRYRUN" Default="True" Mode="" Description="When True, no changes are written (test mode)" Type="Variable" Display="always" Required="false" Mask="false">True</Config>
  <Config Name="Sync Interval" Target="SLEEP_DURATION" Default="3600" Mode="" Description="Seconds between sync cycles" Type="Variable" Display="always" Required="false" Mask="false">3600</Config>
  <Config Name="User Mapping" Target="USER_MAPPING" Default="" Mode="" Description="JSON map of usernames across servers (e.g. {&quot;PlexUser&quot;: &quot;JellyfinUser&quot;})" Type="Variable" Display="advanced" Required="false" Mask="false"/>
  <Config Name="Library Mapping" Target="LIBRARY_MAPPING" Default="" Mode="" Description="JSON map of library names across servers" Type="Variable" Display="advanced" Required="false" Mask="false"/>
  <Config Name="Debug Level" Target="DEBUG_LEVEL" Default="INFO" Mode="" Description="Log level (DEBUG, INFO, WARNING, ERROR)" Type="Variable" Display="advanced" Required="false" Mask="false">INFO</Config>
  <Config Name="Plex to Jellyfin" Target="SYNC_FROM_PLEX_TO_JELLYFIN" Default="True" Mode="" Description="Sync Plex → Jellyfin" Type="Variable" Display="advanced" Required="false" Mask="false">True</Config>
  <Config Name="Jellyfin to Plex" Target="SYNC_FROM_JELLYFIN_TO_PLEX" Default="True" Mode="" Description="Sync Jellyfin → Plex" Type="Variable" Display="advanced" Required="false" Mask="false">True</Config>
  <Config Name="Plex to Emby" Target="SYNC_FROM_PLEX_TO_EMBY" Default="True" Mode="" Description="Sync Plex → Emby" Type="Variable" Display="advanced" Required="false" Mask="false">True</Config>
  <Config Name="Emby to Plex" Target="SYNC_FROM_EMBY_TO_PLEX" Default="True" Mode="" Description="Sync Emby → Plex" Type="Variable" Display="advanced" Required="false" Mask="false">True</Config>
  <Config Name="Seerr URL" Target="SEERR_BASEURL" Default="" Mode="" Description="Overseerr or Jellyseerr URL (e.g. http://192.168.1.100:5055)" Type="Variable" Display="always" Required="false" Mask="false"/>
  <Config Name="Seerr API Key" Target="SEERR_API_KEY" Default="" Mode="" Description="Seerr API key (Settings > General in Seerr UI)" Type="Variable" Display="always" Required="false" Mask="true"/>
  <Config Name="Request Timeout" Target="REQUEST_TIMEOUT" Default="300" Mode="" Description="API request timeout in seconds" Type="Variable" Display="advanced" Required="false" Mask="false">300</Config>
  <Config Name="SSL Bypass" Target="SSL_BYPASS" Default="False" Mode="" Description="Bypass SSL verification" Type="Variable" Display="advanced" Required="false" Mask="false">False</Config>
  <Config Name="Cleanup Enabled" Target="CLEANUP_ENABLED" Default="False" Mode="" Description="Enable media lifecycle cleanup" Type="Variable" Display="always" Required="false" Mask="false">False</Config>
  <Config Name="Cleanup Dry Run" Target="CLEANUP_DRY_RUN" Default="True" Mode="" Description="Log only, no actual deletions" Type="Variable" Display="always" Required="false" Mask="false">True</Config>
  <Config Name="Sonarr URL" Target="SONARR_BASEURL" Default="" Mode="" Description="Sonarr server URL (e.g. http://192.168.1.100:8989)" Type="Variable" Display="always" Required="false" Mask="false"/>
  <Config Name="Sonarr API Key" Target="SONARR_API_KEY" Default="" Mode="" Description="Sonarr API key" Type="Variable" Display="always" Required="false" Mask="true"/>
  <Config Name="Radarr URL" Target="RADARR_BASEURL" Default="" Mode="" Description="Radarr server URL (e.g. http://192.168.1.100:7878)" Type="Variable" Display="always" Required="false" Mask="false"/>
  <Config Name="Radarr API Key" Target="RADARR_API_KEY" Default="" Mode="" Description="Radarr API key" Type="Variable" Display="always" Required="false" Mask="true"/>
  <Config Name="Cleanup Exclude Titles" Target="CLEANUP_EXCLUDE_TITLES" Default="" Mode="" Description="Comma-separated titles or patterns to exclude (e.g. Star*,Battlestar*)" Type="Variable" Display="advanced" Required="false" Mask="false"/>
  <Config Name="Data Directory" Target="/app/data" Default="/mnt/user/appdata/ferret/data" Mode="rw" Description="Persistent data (cleanup state)" Type="Path" Display="advanced" Required="false" Mask="false">/mnt/user/appdata/ferret/data</Config>
</Container>
